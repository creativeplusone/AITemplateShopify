        "default": 0
      },
      {
        "type": "header",
        "content": "Grid"
      },
      {
        "type": "paragraph",
        "content": "Affects areas of your theme that use the product grid."
      },
      {
        "type": "range",
        "id": "spacing_grid_horizontal",
        "min": 4,
        "max": 40,
        "step": 4,
        "default": 8,
        "unit": "px",
        "label": "Horizontal spacing"
      },
      {
        "type": "range",
        "id": "spacing_grid_vertical",
        "min": 4,
        "max": 40,
        "step": 4,
        "default": 8,
        "unit": "px",
        "label": "Vertical spacing"
      }
    ]
  },
  {
